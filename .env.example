# PostgreSQL
POSTGRES_USER=toeic
POSTGRES_PASSWORD=toeic
POSTGRES_DB=toeic
DATABASE_URL=postgresql+psycopg://toeic:toeic@localhost:5432/toeic

# Redis
REDIS_URL=redis://localhost:6379/0

# API
# ENVIRONMENT=production refuses to boot on the default SECRET_KEY.
ENVIRONMENT=development
API_HOST=0.0.0.0
API_PORT=8000
# Generate with: openssl rand -hex 32
SECRET_KEY=change-me-in-production-use-openssl-rand-hex-32
ACCESS_TOKEN_EXPIRE_MINUTES=10080
LOG_LEVEL=INFO
# "json" for shipping, "text" for reading locally
LOG_FORMAT=json

# Web (Next.js)
NEXT_PUBLIC_API_URL=http://localhost:8000
