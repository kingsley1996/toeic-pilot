# PostgreSQL
POSTGRES_USER=toeic
POSTGRES_PASSWORD=toeic
POSTGRES_DB=toeic
DATABASE_URL=postgresql+psycopg://toeic:toeic@localhost:5432/toeic

# Redis
REDIS_URL=redis://localhost:6379/0

# API
# ENVIRONMENT=production refuses to boot on the default SECRET_KEY.
ENVIRONMENT=development
API_HOST=0.0.0.0
API_PORT=8000
# Generate with: openssl rand -hex 32
SECRET_KEY=change-me-in-production-use-openssl-rand-hex-32
ACCESS_TOKEN_EXPIRE_MINUTES=10080
LOG_LEVEL=INFO
# "json" for shipping, "text" for reading locally
LOG_FORMAT=json
# Prefix for playable audio URLs. In development this is the /media mount this
# app serves; in production it is the CDN origin. The API only concatenates it
# with a storage key — it never calls the object store at request time.
AUDIO_PUBLIC_BASE_URL=http://localhost:8000/media

# --- Media upload (planning/ADR-006-MEDIA-UPLOAD.md) -------------------------
# Hai driver TÁCH RIÊNG. Ảnh cần biến đổi và ít băng thông; audio thì ngược lại.
# Ép chung một nơi là chọn sai ở một trong hai đầu (ADR-006 §2.2).
#
# "local" ghi thẳng vào MEDIA_ROOT và chỉ dùng cho dev/test — route nhận file
# chỉ được gắn khi ENVIRONMENT=development, cùng luật với mount /media.
# "local" | "cloudinary" | "s3"   (ảnh)
IMAGE_STORAGE_DRIVER=local
# "local" | "s3"                  (audio)
AUDIO_STORAGE_DRIVER=local

# Tiền tố URL công khai của ảnh. Với Cloudinary:
#   https://res.cloudinary.com/<cloud_name>/image/upload
IMAGE_PUBLIC_BASE_URL=http://localhost:8000/media

# Điền bốn dòng dưới rồi đặt IMAGE_STORAGE_DRIVER=cloudinary.
# Thiếu bất kỳ dòng nào thì API TỪ CHỐI KHỞI ĐỘNG với thông báo nêu đúng tên
# biến còn thiếu — cấu hình nửa vời phải hỏng ở chỗ có người đang nhìn, không
# phải ở request đầu tiên của một biên tập viên đang dở tay nhập đề.
#
# Lấy ở Cloudinary Console > Settings > API Keys. API secret là bí mật thật:
# nó ký mọi vé upload, ai có nó thì upload được vào tài khoản của bạn.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
CLOUDINARY_FOLDER=toeic-pilot

# Content pipeline only — the API runtime never reads anything below.
# These belong to the offline `app.content` tooling, which is the only thing
# that writes to the object store. Keeping write credentials out of the HTTP
# process is deliberate; do not merge these into the API service environment.
# OBJECT_STORE_DIR=apps/api/media
# Bump only when you intend to re-synthesise the entire audio library: it
# feeds the source hash, so changing it invalidates every existing asset.
# TTS_ENGINE_VERSION=1
# Same warning for images. Wikimedia returns 403 without an identifying
# User-Agent and 429 if you fetch too fast, so both of these matter in practice.
# IMAGE_TRANSFORM_VERSION=1
# HTTP_USER_AGENT=ToeicPilot-content/1.0 (contact: you@example.com)
# IMAGE_FETCH_DELAY_SECONDS=1.5
# --- Object store S3 cho AUDIO (ADR-006 §2.2) --------------------------------
# MỘT driver cho mọi nhà cung cấp nói giao thức S3. Endpoint quyết định đó là
# ai — Supabase, Backblaze B2, Cloudflare R2, DO Spaces, Wasabi hay MinIO. Đổi
# nhà cung cấp là đổi bốn dòng dưới, không phải sửa code.
#
#   Supabase   https://<project-ref>.supabase.co/storage/v1/s3
#   B2         https://s3.<region>.backblazeb2.com
#   R2         https://<account-id>.r2.cloudflarestorage.com
#   DO Spaces  https://<region>.digitaloceanspaces.com
#
# Khoá lấy ở Supabase: Project Settings > Storage > S3 access keys. Đây là khoá
# GHI — nó không thuộc về tiến trình HTTP nếu bạn chỉ đẩy nội dung sinh sẵn
# (xem `push-media` bên dưới); chỉ đặt vào môi trường của API khi đã bật luồng
# upload từ trình duyệt.
# S3_ENDPOINT_URL=
# S3_REGION=auto
# S3_BUCKET=
# S3_ACCESS_KEY_ID=
# S3_SECRET_ACCESS_KEY=
#
# Đẩy audio/ảnh đã sinh sẵn ở máy lên object store (chạy ở máy dev, cần extra
# `content`):
#   uv run python -m app.content.push_media --dry-run
#   uv run python -m app.content.push_media
#
# Rồi trỏ URL phát về bucket công khai và KHÔNG cần đổi gì trong code:
#   AUDIO_PUBLIC_BASE_URL=https://<ref>.supabase.co/storage/v1/object/public/<bucket>
#
# BẪY của gói free Supabase: project TỰ NGỦ sau 7 ngày không có request, và
# storage ngủ theo. Kiểu hỏng của nó khó chẩn đoán — web chạy, Postgres chạy,
# chỉ audio 404. Cần một cron ping giữ nhịp, hoặc vào bấm resume tay.

# Web (Next.js)
NEXT_PUBLIC_API_URL=http://localhost:8000
